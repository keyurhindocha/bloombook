# Copy to .env.local and fill in real values. Never commit .env.local.

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com

# Shared secret between the frontend bundle and API routes.
# Generate with: openssl rand -hex 32
# Add BOTH to Vercel env vars (VITE_APP_SECRET and APP_SECRET with the same value).
VITE_APP_SECRET=your_app_secret_here
APP_SECRET=your_app_secret_here

# Vercel Cron secret — any random string, also add to Vercel dashboard.
# Generate with: openssl rand -hex 20
CRON_SECRET=your_random_cron_secret_here

# Upstash Redis — from Vercel Integrations > Upstash > your database
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
